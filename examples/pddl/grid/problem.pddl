(define (problem tiny-grid-instance)
  (:domain tiny-grid)
  (:objects s00 s10 s20 s01 s11 s21 - location)
  (:init
    (at s00)
    (adjacent s00 s10)
    (adjacent s10 s00)
    (adjacent s10 s20)
    (adjacent s20 s10)
    (adjacent s00 s01)
    (adjacent s01 s00)
    (adjacent s01 s11)
    (adjacent s11 s01)
    (adjacent s11 s21)
    (adjacent s21 s11)
    (adjacent s20 s21)
    (adjacent s21 s20)
    (blocked s11)
    (= (total-cost) 0))
  (:goal (at s21))
  (:metric minimize (total-cost))
)
